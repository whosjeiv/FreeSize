{
  "name": "freesize",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "vite:dev": "vite",
    "dev": "concurrently \"npm run vite:dev\" \"wait-on tcp:5173 && node scripts/launch.cjs\"",
    "build": "vite build",
    "preview": "vite preview",
    "pack": "vite build && electron-builder --windows"
  },
  "build": {
    "appId": "com.freesize.app",
    "productName": "FreeSize",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "vite": "^5.4.11",
    "wait-on": "^9.0.4"
  }
}
